<Window x:Class="AiUsageMonitor.ContextMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <Style x:Key="DarkMenuBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F0FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IntervalPillBtn" TargetType="Button">
            <Setter Property="Background" Value="#0EFFFFFF"/>
            <Setter Property="Foreground" Value="#B0FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F42A2A2A"
            BorderBrush="#24FFFFFF"
            BorderThickness="1"
            CornerRadius="8"
            Padding="5"
            MinWidth="225">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <Button Style="{StaticResource DarkMenuBtn}" Content="Obnovit teď" Click="Refresh_Click"/>
            <Button Style="{StaticResource DarkMenuBtn}" Content="Zobrazit detail" Click="Detail_Click"/>

            <Border Height="1" Background="#16FFFFFF" Margin="6,4"/>

            <Button Style="{StaticResource DarkMenuBtn}" Click="ToggleAg_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="AgCheck" Text="✓" Width="16" Foreground="#34D399" FontWeight="Bold"/>
                    <TextBlock Text="Zobrazit Antigravity (AG)"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource DarkMenuBtn}" Click="ToggleCl_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ClCheck" Text="✓" Width="16" Foreground="#D97757" FontWeight="Bold"/>
                    <TextBlock Text="Zobrazit Claude Code (CL)"/>
                </StackPanel>
            </Button>

            <Border Height="1" Background="#16FFFFFF" Margin="6,4"/>

            <StackPanel Margin="10,4,6,5">
                <TextBlock Text="Frekvence obnovení" Foreground="#88FFFFFF" FontSize="11" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="Btn30s" Style="{StaticResource IntervalPillBtn}" Content="30s" Tag="30" Click="Interval_Click"/>
                    <Button x:Name="Btn1m" Style="{StaticResource IntervalPillBtn}" Content="1m" Tag="60" Click="Interval_Click"/>
                    <Button x:Name="Btn2m" Style="{StaticResource IntervalPillBtn}" Content="2m" Tag="120" Click="Interval_Click"/>
                    <Button x:Name="Btn5m" Style="{StaticResource IntervalPillBtn}" Content="5m" Tag="300" Margin="0" Click="Interval_Click"/>
                </StackPanel>
            </StackPanel>

            <Border Height="1" Background="#16FFFFFF" Margin="6,4"/>

            <Button Style="{StaticResource DarkMenuBtn}" Click="Startup_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StartupCheck" Text="✓" Width="16" Foreground="#34D399" FontWeight="Bold"/>
                    <TextBlock Text="Spustit při startu Windows"/>
                </StackPanel>
            </Button>

            <Border Height="1" Background="#16FFFFFF" Margin="6,4"/>

            <Button Style="{StaticResource DarkMenuBtn}" Content="Ukončit" Click="Exit_Click"/>
        </StackPanel>
    </Border>
</Window>
