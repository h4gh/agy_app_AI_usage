<Window x:Class="AiUsageMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Loaded="Window_Loaded"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseRightButtonUp="Window_MouseRightButtonUp">

    <Border x:Name="RootPill"
            Height="38"
            CornerRadius="6"
            Background="#01000000"
            Padding="8,2"
            Cursor="Hand"
            MouseEnter="RootPill_MouseEnter"
            MouseLeave="RootPill_MouseLeave">

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Antigravity Block (Varianta C) -->
            <StackPanel x:Name="AgBlock" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="AG" Width="21" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#34D399"/>
                    <TextBlock x:Name="Ag5hPct" Text="--%" Width="32" TextAlignment="Right" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#F2FFFFFF"/>
                    <TextBlock Text="·" Margin="5,0" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Foreground="#66FFFFFF"/>
                    <TextBlock x:Name="Ag5hReset" Text="--" MinWidth="28" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Foreground="#CCFFFFFF"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Ar" Width="21" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Foreground="#99FFFFFF"/>
                    <TextBlock x:Name="AgWPct" Text="--%" Width="32" TextAlignment="Right" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#D9FFFFFF"/>
                    <TextBlock Text="·" Margin="5,0" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Foreground="#66FFFFFF"/>
                    <TextBlock x:Name="AgWReset" Text="--" MinWidth="28" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Foreground="#99FFFFFF"/>
                </StackPanel>
            </StackPanel>

            <!-- Divider -->
            <Border x:Name="Divider" Width="1" Height="26" Background="#24FFFFFF" Margin="11,0"/>

            <!-- Claude Code Block (Varianta C) -->
            <StackPanel x:Name="ClBlock" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="CL" Width="21" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#D97757"/>
                    <TextBlock x:Name="Cl5hPct" Text="--%" Width="32" TextAlignment="Right" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#F2FFFFFF"/>
                    <TextBlock Text="·" Margin="5,0" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Foreground="#66FFFFFF"/>
                    <TextBlock x:Name="Cl5hReset" Text="--" MinWidth="28" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Foreground="#CCFFFFFF"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="W" Width="21" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Foreground="#99FFFFFF"/>
                    <TextBlock x:Name="ClWPct" Text="--%" Width="32" TextAlignment="Right" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#D9FFFFFF"/>
                    <TextBlock Text="·" Margin="5,0" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Foreground="#66FFFFFF"/>
                    <TextBlock x:Name="ClWReset" Text="--" MinWidth="28" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Foreground="#99FFFFFF"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
