<Window x:Class="AiUsageMonitor.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Deactivated="Window_Deactivated">
    <Border Background="#F2242424"
            BorderBrush="#24FFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14"
            Width="430">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,10">
                <TextBlock Text="AI Usage Monitor"
                           Foreground="#F0FFFFFF"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="13"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="UpdatedText"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="#80FFFFFF"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="11"
                           Text="Načítám..."/>
            </Grid>

            <Border Height="1" Background="#16FFFFFF" Margin="0,0,0,10"/>

            <!-- Two Columns -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Antigravity Card -->
                <Border Grid.Column="0"
                        Background="#0AFFFFFF"
                        BorderBrush="#12FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse Width="7" Height="7" Fill="#34D399" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Antigravity"
                                       Foreground="#34D399"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel x:Name="AgItemsPanel"/>
                    </StackPanel>
                </Border>

                <!-- Claude Code Card -->
                <Border Grid.Column="2"
                        Background="#0AFFFFFF"
                        BorderBrush="#12FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse Width="7" Height="7" Fill="#D97757" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Claude Code"
                                       Foreground="#D97757"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel x:Name="ClItemsPanel"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</Window>
